# Frontend
# Leave this as /api for local development and reverse-proxy deployments.
# Vite proxies it to BACKEND_DEV_SERVER_URL (default: http://127.0.0.1:8000).
VITE_API_BASE_URL=/api
BACKEND_DEV_SERVER_URL=http://127.0.0.1:8000
VITE_AMAP_KEY=your-amap-web-js-api-key
VITE_AMAP_SERVICE_HOST=http://localhost:5175/_AMapService
# Server-side only. Never add a VITE_ prefix.
AMAP_SECURITY_JS_CODE=your-amap-security-js-code

# Backend
APP_NAME=Building Exterior Inspection Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=building_exterior
POSTGRES_USER=building_exterior
POSTGRES_PASSWORD=building_exterior_password
DATABASE_URL=postgresql+psycopg://building_exterior:building_exterior_password@localhost:5433/building_exterior

# MinIO
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_BIND_HOST=127.0.0.1
MINIO_ENDPOINT=localhost:9002
MINIO_PUBLIC_URL=http://localhost:9002
MINIO_ACCESS_KEY=building_exterior_minio
MINIO_SECRET_KEY=building_exterior_minio_secret
MINIO_BUCKET=building-exterior

# Redis / RQ reserved for later algorithm jobs
REDIS_URL=redis://localhost:6379/0
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
RQ_DEFAULT_QUEUE=algorithm
SECURITY_STORE_BACKEND=memory
SECURITY_FAIL_CLOSED=false

# Public abuse controls. Production must use Redis and fail closed.
LOGIN_RATE_LIMIT_PER_IDENTITY=5
LOGIN_RATE_WINDOW_SECONDS=900
TRIAL_APPLICATION_LIMIT_PER_IDENTITY=3
TRIAL_APPLICATION_WINDOW_SECONDS=86400

# Trial: per-user Asia/Shanghai daily quota for preflight model API requests.
TRIAL_DAILY_API_REQUEST_LIMIT=800
TRIAL_MAX_FILE_SIZE_BYTES=5242880
TRIAL_MAX_IMAGE_PIXELS=64000000
TRIAL_INFERENCE_MAX_IMAGE_PIXELS=64000000
TRIAL_MAX_TILES_PER_IMAGE=100
TRIAL_MAX_TILES_PER_REQUEST=1000
TRIAL_GENERATE_LIMIT_PER_USER=5
TRIAL_GENERATE_WINDOW_SECONDS=600
TRIAL_UPLOAD_LIMIT_PER_USER=30
TRIAL_UPLOAD_WINDOW_SECONDS=600
TRIAL_GLOBAL_JOB_CONCURRENCY=4
TRIAL_JOB_LOCK_SECONDS=900

# Building-photo precheck through Qwen3-VL-Flash on DashScope. Originals are
# persisted to MinIO first. Blank overrides reuse DASHSCOPE_API_KEY,
# QWEN_API_BASE_URL and QWEN3_VL_FLASH_MODEL below.
PHOTO_GUARD_ENABLED=true
PHOTO_GUARD_PROVIDER=dashscope
PHOTO_GUARD_API_BASE_URL=
PHOTO_GUARD_MODEL=
PHOTO_GUARD_API_KEY=
PHOTO_GUARD_REQUEST_TIMEOUT_SECONDS=60
PHOTO_GUARD_REQUEST_CONCURRENCY=5
PHOTO_GUARD_MAX_SOURCE_PIXELS=64000000
PHOTO_GUARD_MAX_INFERENCE_PIXELS=1500000
PHOTO_GUARD_MAX_EDGE=1280
PHOTO_GUARD_JPEG_QUALITY=82
# Production must never treat precheck failures as passed.
PHOTO_GUARD_FAIL_OPEN=false

WEATHER_RATE_LIMIT_PER_USER=20
WEATHER_RATE_WINDOW_SECONDS=60
WEATHER_DAILY_UPSTREAM_LIMIT_PER_USER=100
WEATHER_CACHE_TTL_NOW_SECONDS=300
WEATHER_CACHE_TTL_FORECAST_SECONDS=900

# Formal project detection worker contract. These settings are not used by /trial.
# Dev/test uses mock worker only; the real model is not deployed locally.
# In production, frontend/backend and the algorithm services run on one server.
# The worker follows the algorithm model deployment, preferably as a separate
# container from algorithm-model on a private Docker network.
WORKER_BACKEND_BASE_URL=http://localhost:8000
# Docker worker should reach the host through Nginx; the worker appends /api.
WORKER_CONTAINER_BACKEND_BASE_URL=http://host.docker.internal
WORKER_ID=mock-worker-local
WORKER_TOKEN=change-this-worker-token
WORKER_MODEL_VERSION=trial-crack-spalling-v1
WORKER_LEASE_SECONDS=600
WORKER_MODE=mock
ALGORITHM_INFERENCE_URL=http://algorithm-model:9002
ALGORITHM_INFERENCE_TIMEOUT_SECONDS=300

# Trial experience: backend-only vision API settings (Qwen by default).
# Keep the real key in the ignored .env.local file. Never expose it through VITE_*.
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus
# Qwen3-VL-Flash reuses DASHSCOPE_API_KEY and QWEN_API_BASE_URL.
QWEN3_VL_FLASH_MODEL=qwen3-vl-flash
# Local OpenAI-compatible Qwen3-VL endpoint (for example, vLLM).
# LOCAL_QWEN_API_KEY may stay empty when the local server has no authentication.
LOCAL_QWEN_API_BASE_URL=http://127.0.0.1:9005/v1
LOCAL_QWEN_MODEL=qwen3-vl-32b
LOCAL_QWEN_API_KEY=
# Optional on-demand vLLM lifecycle. Enable only when the backend host owns the GPUs.
LOCAL_QWEN_CONTROL_ENABLED=false
LOCAL_QWEN_VLLM_EXECUTABLE=/path/to/vllm
LOCAL_QWEN_MODEL_PATH=/path/to/Qwen3-VL-32B-Instruct-FP8
LOCAL_QWEN_CUDA_VISIBLE_DEVICES=0,1
# Set this when FlashInfer needs runtime JIT compilation and CUDA is not under /usr/local/cuda.
LOCAL_QWEN_CUDA_HOME=/path/to/cuda
LOCAL_QWEN_USE_DEEP_GEMM=false
LOCAL_QWEN_USE_FLASHINFER_SAMPLER=false
LOCAL_QWEN_TENSOR_PARALLEL_SIZE=2
# Maximum simultaneous image sequences for the local model. Start at 1 to
# leave enough activation memory for Qwen3-VL-32B; cloud concurrency is separate.
LOCAL_QWEN_MAX_CONCURRENCY=1
# Leave room on GPU 0 for the always-on 2B photo guard.
LOCAL_QWEN_GPU_MEMORY_UTILIZATION=0.75
LOCAL_QWEN_MAX_MODEL_LEN=16384
LOCAL_QWEN_MM_ENCODER_TP_MODE=weights
LOCAL_QWEN_DISABLE_CUSTOM_ALL_REDUCE=true
LOCAL_QWEN_MAX_IMAGES_PER_PROMPT=4
LOCAL_QWEN_STARTUP_TIMEOUT_SECONDS=300
LOCAL_QWEN_STOP_TIMEOUT_SECONDS=30
TRIAL_REQUEST_TIMEOUT_SECONDS=300
TRIAL_REQUEST_CONCURRENCY=5

# Optional backup provider for /trial. The active provider is selected by an
# administrator under 管理中心 -> 系统设置; keys are never exposed to frontend.
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6v

# Formal project algorithm model runtime; /trial does not load these local weights.
# The default PyTorch index installs CUDA 12.8 wheels.
# Use https://download.pytorch.org/whl/cpu for CPU-only validation.
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ALGORITHM_GPU_COUNT=1
ALGORITHM_MODEL_PORT=9004
MODEL_DEVICE=auto
MODEL_DIR=./models
MODEL_VERSION=trial-crack-spalling-v1
CRACK_MODEL_WEIGHTS_PATH=/models/wall_crack_yolo11x.pt
SPALLING_MODEL_WEIGHTS_PATH=/models/missing.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IMAGE_SIZE=1280
MODEL_HIGH_PRECISION_IMAGE_SIZE=1280
MODEL_TILED_INFERENCE_ENABLED=true
MODEL_TILE_SIZE=1280
MODEL_HIGH_PRECISION_TILE_SIZE=1280
MODEL_TILE_OVERLAP_RATIO=0.25
MODEL_TILE_NMS_IOU_THRESHOLD=0.5

# Authentication. Change AUTH_SECRET_KEY and disable demo users in production.
AUTH_SECRET_KEY=change-this-auth-secret-key-before-production
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_SEED_DEMO_USERS=true

# QWeather API connectivity test
# Use the dedicated API Host from QWeather Console Settings, not api.qweather.com.
QWEATHER_API_HOST=your-qweather-api-host.qweatherapi.com
# API Key auth sends X-QW-Api-Key and takes precedence over JWT settings below.
QWEATHER_API_KEY=
QWEATHER_DEVELOPER_ID=your-qweather-developer-id
QWEATHER_PROJECT_ID=your-qweather-project-id
QWEATHER_CREDENTIAL_ID=your-qweather-credential-id
QWEATHER_PUBLIC_KEY_PATH=/path/to/ed25519-public.pem
QWEATHER_PUBLIC_KEY_SHA256=your-qweather-public-key-sha256
QWEATHER_PRIVATE_KEY_PATH=/path/to/ed25519-private.pem
QWEATHER_TEST_LOCATION=116.41,39.92
QWEATHER_LANGUAGE=zh
QWEATHER_JWT_TTL_SECONDS=900
QWEATHER_REQUEST_TIMEOUT_SECONDS=10
